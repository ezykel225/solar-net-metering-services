# Copy to .env.local for local development, and add the same variables in
# Vercel → Project Settings → Environment Variables. Never commit real values.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public URL of the deployed site (canonical URLs, sitemap, Open Graph, admin links in emails).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---------------------------------------------------------------------------
# Supabase — public (safe in the browser; access is limited by RLS policies)
# Supabase dashboard → Project Settings → API / API Keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The legacy "anon" key or the new publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — SERVER ONLY. Never add the NEXT_PUBLIC_ prefix.
# The legacy "service_role" key or a new secret key (sb_secret_...).
# Used only by /api/quote to save quote requests.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Quote notification email (optional; SERVER ONLY) — https://resend.com
# Without RESEND_API_KEY, quotes are still saved and shown in Admin → Quote Requests.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
QUOTE_NOTIFY_TO=solarandnetmeteringservices@gmail.com
# Must be a sender on a domain verified in Resend, e.g. "Website <quotes@yourdomain.com>".
QUOTE_NOTIFY_FROM=
